# Copy to .env and fill in. All of this is optional -- the server works with zero config, using
# public defaults. See packages/server/README.md for the full picture.

# A standard Solana RPC endpoint. No key needed at all -- the public default works, though a
# private endpoint (Helius/Triton/QuickNode) is more reliable under load. Never commit or log the
# real value if it embeds an API key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# A dedicated Ethereum RPC endpoint (Alchemy/Infura/QuickNode etc.) -- optional. Unlike Solana,
# there's no reliable free public Ethereum mainnet RPC to default to, so leaving this unset falls
# back to Blockscout's free REST API instead (no key needed, just slower/more rate-limited under
# load). Never commit or log the real value if it embeds an API key.
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key-here

# Port and bind host for the unified server (packages/server).
PORT=5320
HOST=127.0.0.1

# Exact browser origins allowed to call the server (comma-separated). Never "*". Defaults to
# http://127.0.0.1:5301,http://localhost:5301 if unset -- add your own dev frontend's origin here
# if it's different (e.g. a tailscale/LAN address).
ALLOWED_ORIGINS=http://127.0.0.1:5301,http://localhost:5301

# Local dev only: treats every request as signed in as a fixed fake user, so every feature can be
# driven without going through the real Phantom/MetaMask wallet-connect flow. Refused outright
# when NODE_ENV=production, so it can never activate on a deployed instance. Set to 0 (or unset)
# to test the real wallet-connect flow instead.
DEV_SKIP_AUTH=1

# Public receiving-wallet addresses only (ADR 0020) -- never a private key. A chain left blank
# just can't take bounty deposits yet; this project never generates or holds the key behind
# either address.
DEPOSIT_WALLET_ETHEREUM=
DEPOSIT_WALLET_SOLANA=

# --- Rarely need to change these ---

# Where the server's SQLite database lives. Relative paths resolve from packages/server/'s cwd.
SERVER_DB=./data/server.db
# Disables new wallet sign-ups (existing sessions keep working) -- e.g. for a frozen demo instance.
ALLOW_SIGNUP=true
# How often the alerts background worker polls watched addresses, in seconds (minimum 5).
ALERT_POLL_SEC=60
# Ethereum balance/transaction data source (no API key needed).
ETH_BLOCKSCOUT_URL=https://eth.blockscout.com
# Token price data source.
DEFILLAMA_URL=https://coins.llama.fi
# Enables POST /api/_test/alerts/tick, used by the test suite -- leave off otherwise.
SERVER_TEST_HOOKS=

# --- Frontend (packages/web), set via the shell or a packages/web/.env.local, not this file ---
# VITE_SERVER_URL=http://localhost:5320
