{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "verbatimModuleSyntax": true
  },
  "references": [
    { "path": "packages/core" },
    { "path": "packages/chains/ethereum" },
    { "path": "packages/chains/solana" },
    { "path": "packages/features/explorer" }
  ]
}
