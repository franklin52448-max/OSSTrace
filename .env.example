# Copy to .env and fill in. All of this is optional -- the server works with zero config, using
# public defaults. See packages/server/README.md for the full picture.

# A standard Solana RPC endpoint. No key needed at all -- the public default works, though a
# private endpoint (Helius/Triton/QuickNode) is more reliable under load. Never commit or log the
# real value if it embeds an API key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# A dedicated Ethereum RPC endpoint (Alchemy/Infura/QuickNode etc.) -- optional. Unlike Solana,
# there's no reliable free public Ethereum mainnet RPC to default to, so leaving this unset falls
# back to Blockscout's free REST API instead (no key needed, just slower/more rate-limited under
# load). Never commit or log the real value if it embeds an API key.
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key-here

# A Solscan Pro API key -- optional. Used only for a signed-in visitor's deep/full Solana
# transaction history (an indexed API is far cheaper per request than this server's own RPC-based
# per-transaction fetching at real depth). Unset means that history still loads, just progressively
# via RPC like everything else. Never commit or log the real value.
# SOLSCAN_API_KEY=your-key-here

# An Etherscan API key -- BNB Chain only (its history and token discovery; Ethereum doesn't use
# it). Etherscan's V2 API serves every chain with one key, but the FREE plan refuses BNB Smart
# Chain, so BNB lookups need a plan that covers chain 56; without one they report that as an
# error, never as an empty wallet. Never commit or log the real value.
# ETHERSCAN_API_KEY=your-key-here

# BNB Smart Chain JSON-RPC (native balances, token balanceOf, BNB deposit checks). No key needed:
# BNB Chain's own public endpoint is the default; set your own if it rate-limits you.
# BNB_RPC_URL=https://bsc-dataseed.bnbchain.org

# Robinhood Chain (EVM chain id 4663). No key needed: history and balances come from its own
# official Blockscout instance, deposit checks from its own public RPC. Override either if needed.
# ROBINHOOD_BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Base (EVM chain id 8453). History and balances come from Blockscout's hosted PRO API, which needs
# a FREE key (dev.blockscout.com, no card) -- Base's own base.blockscout.com refuses server-side API
# calls with a bot challenge, and Etherscan's free plan refuses Base. Without the key Base lookups
# report it as missing, never as an empty wallet. Never commit or log the real value. Deposit checks
# use Base's own public RPC, no key. BASE_BLOCKSCOUT_URL can point at another Blockscout instance.
# BLOCKSCOUT_API_KEY=your-key-here
# BASE_BLOCKSCOUT_URL=https://api.blockscout.com/8453
# BASE_RPC_URL=https://mainnet.base.org

# Port and bind host for the unified server (packages/server).
PORT=5320
HOST=127.0.0.1

# Exact browser origins allowed to call the server (comma-separated). Never "*". Defaults to
# http://127.0.0.1:5301,http://localhost:5301 if unset -- add your own dev frontend's origin here
# if it's different (e.g. a tailscale/LAN address).
ALLOWED_ORIGINS=http://127.0.0.1:5301,http://localhost:5301

# Local dev only: treats every request as signed in as a fixed fake user, so every feature can be
# driven without going through the real Phantom/MetaMask wallet-connect flow. Refused outright
# when NODE_ENV=production, so it can never activate on a deployed instance. Set to 0 (or unset)
# to test the real wallet-connect flow instead.
DEV_SKIP_AUTH=1

# Public receiving-wallet addresses only (ADR 0020) -- never a private key. A chain left blank
# just can't take bounty deposits yet; this project never generates or holds the key behind
# any of these addresses. Bitcoin is deposit-only (paste a txid; no wallet-connect, no sender check).
# BNB is checked over BNB_RPC_URL; its sender must be the depositor's Ethereum sign-in (same 0x
# address), and it can be the very same address as DEPOSIT_WALLET_ETHEREUM if that key is yours.
# Robinhood Chain works the same way over ROBINHOOD_RPC_URL; it has no USDC/USDT, so beyond native
# ETH its default token is USDG (extend with DEPOSIT_ALLOWED_TOKENS_ROBINHOOD). Base works the same
# way over BASE_RPC_URL: native ETH or Circle's native Base USDC by default (DEPOSIT_ALLOWED_TOKENS_BASE).
DEPOSIT_WALLET_ETHEREUM=
DEPOSIT_WALLET_SOLANA=
DEPOSIT_WALLET_BNB=
DEPOSIT_WALLET_ROBINHOOD=
DEPOSIT_WALLET_BASE=
DEPOSIT_WALLET_BITCOIN=

# --- Rarely need to change these ---

# Where the server's SQLite database lives. Relative paths resolve from packages/server/'s cwd.
SERVER_DB=./data/server.db
# Disables new wallet sign-ups (existing sessions keep working) -- e.g. for a frozen demo instance.
ALLOW_SIGNUP=true
# How often the alerts background worker polls watched addresses, in seconds (minimum 5).
ALERT_POLL_SEC=60
# Ethereum balance/transaction data source (no API key needed).
ETH_BLOCKSCOUT_URL=https://eth.blockscout.com
# Bitcoin bounty-deposit verification source, any Esplora-API explorer (no API key needed);
# https://mempool.space works too.
ESPLORA_URL=https://blockstream.info
# Token price data source.
DEFILLAMA_URL=https://coins.llama.fi
# Solana token logos for the portfolio (no API key needed).
JUPITER_TOKENS_URL=https://lite-api.jup.ag/tokens/v2
# Enables POST /api/_test/alerts/tick, used by the test suite -- leave off otherwise.
SERVER_TEST_HOOKS=

# --- Frontend (packages/web), set via the shell or a packages/web/.env.local, not this file ---
# VITE_SERVER_URL=http://localhost:5320
