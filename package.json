{
  "name": "osstrace",
  "private": true,
  "description": "Open-source, multi-chain on-chain intelligence platform: address/entity lookup, sourced labels, and pluggable chain + feature modules.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/contract",
    "packages/server",
    "packages/chains/*",
    "packages/features/*",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p packages/web && tsc --noEmit -p packages/web/tests && tsc --noEmit -p packages/contract/tests && tsc --noEmit -p packages/server/tests",
    "test": "find packages scripts -path '*/node_modules' -prune -o -regex '.*/tests/[^/]*\\.test\\.ts' -print | grep -vE '^packages/(contract|server)/' | xargs node --experimental-strip-types --test",
    "test:server": "npm run test --workspace packages/contract --workspace packages/server",
    "check": "npm run typecheck && npm run test && npm run test:server",
    "dev:server": "npm run dev --workspace packages/server",
    "ingest:ofac": "node --experimental-strip-types scripts/ingest-ofac-sdn.ts",
    "ingest:uk": "node --experimental-strip-types scripts/ingest-uk-sanctions.ts",
    "ingest:safe": "node --experimental-strip-types scripts/ingest-safe-deployments.ts",
    "dev:explorer": "npm run dev --workspace packages/features/explorer",
    "dev:indexer": "npm run indexer --workspace packages/features/explorer",
    "dev:visualizer": "npm run dev --workspace packages/features/visualizer",
    "dev:web": "npm run dev --workspace packages/web",
    "dev:accounts": "npm run dev --workspace packages/features/accounts",
    "dev:private-labels": "npm run dev --workspace packages/features/private-labels",
    "dev:community-labels": "npm run dev --workspace packages/features/community-labels",
    "dev:tracer": "npm run dev --workspace packages/features/tracer",
    "dev:risk": "npm run dev --workspace packages/features/risk-scoring",
    "dev:cases": "npm run dev --workspace packages/features/case-management"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.9.1"
  }
}
