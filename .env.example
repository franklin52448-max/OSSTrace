# Copy to .env and fill in. All of this is optional -- the server works with zero config, using
# public defaults. See packages/server/README.md for the full picture.

# A standard Solana RPC endpoint. No key needed at all -- the public default works, though a
# private endpoint (Helius/Triton/QuickNode) is more reliable under load. Never commit or log the
# real value if it embeds an API key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# A dedicated Ethereum RPC endpoint (Alchemy/Infura/QuickNode etc.) -- optional. Unlike Solana,
# there's no reliable free public Ethereum mainnet RPC to default to, so leaving this unset falls
# back to Blockscout's free REST API instead (no key needed, just slower/more rate-limited under
# load). Never commit or log the real value if it embeds an API key.
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key-here

# A Solscan Pro API key -- optional. Used only for a signed-in visitor's deep/full Solana
# transaction history (an indexed API is far cheaper per request than this server's own RPC-based
# per-transaction fetching at real depth). Unset means that history still loads, just progressively
# via RPC like everything else. Never commit or log the real value.
# SOLSCAN_API_KEY=your-key-here

# An OpenRouter API key for the Tracer page's AI agent -- optional, and a key of its own (not shared
# with anything else) so this feature's spend can be tracked and capped separately on OpenRouter.
# Used server-side only, to authenticate the agent's LLM calls; it is never part of what the model
# sees. Unset means the agent answers HTTP 503 "not configured" -- never a stand-in reply.
# TRACER_AGENT_MODEL overrides the model (default openai/gpt-4.1-mini, see config.ts).
# Never commit or log the real value.
# OPENROUTER_API_KEY_TRACER_AGENT=your-key-here
# TRACER_AGENT_MODEL=openai/gpt-4.1-mini

# An Etherscan API key -- not read by the unified server at all (BNB Chain used to need it; it now
# reads Alchemy, below). Only the standalone Explorer/Tracer/Visualizer packages' Ethereum adapter
# (packages/chains/ethereum) uses it, for Ethereum history. Never commit or log the real value.
# ETHERSCAN_API_KEY=your-key-here

# BNB Smart Chain JSON-RPC. Deposit checks work on the keyless public default below; address
# lookups (history, balances) need an Alchemy URL here (https://bnb-mainnet.g.alchemy.com/v2/<key>),
# because they use Alchemy's enhanced API -- on any other RPC they report that, never an empty wallet.
# The key is part of the URL: never commit or log the real value.
# BNB_RPC_URL=https://bsc-dataseed.bnbchain.org

# Robinhood Chain (EVM chain id 4663) and Base (8453): same shape as BNB above. Deposit checks work
# on the keyless public defaults; address lookups need Alchemy URLs here
# (https://robinhood-mainnet.g.alchemy.com/v2/<key>, https://base-mainnet.g.alchemy.com/v2/<key>) --
# their own Blockscout instances refuse server-side API calls with a bot challenge. On any other RPC
# lookups report that, never an empty wallet. Never commit or log the real values.
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# BASE_RPC_URL=https://mainnet.base.org

# Arbitrum One (42161), OP Mainnet (10), Zora (7777777), Lens Chain (232) and the Data Network (1514,
# formerly Story -- hence STORY_*): same shape again. Each defaults to the chain's own public RPC
# (shown below), enough for deposit checks; address lookups need Alchemy URLs here:
#   https://arb-mainnet.g.alchemy.com/v2/<key>    https://opt-mainnet.g.alchemy.com/v2/<key>
#   https://zora-mainnet.g.alchemy.com/v2/<key>   https://lens-mainnet.g.alchemy.com/v2/<key>
#   https://story-mainnet.g.alchemy.com/v2/<key>
# (one Alchemy key serves all of them, the same as the chains above). Each
# also accepts *_RPC_URL_FILE, a file holding just the URL. Never commit or log the real values.
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# OPTIMISM_RPC_URL=https://mainnet.optimism.io
# ZORA_RPC_URL=https://rpc.zora.energy
# LENS_RPC_URL=https://rpc.lens.xyz
# STORY_RPC_URL=https://mainnet.datarpc.io

# Gnosis Chain (100), Ronin (2020) and Rootstock (30): same shape again. Each defaults to the chain's
# operator's public RPC (shown below), enough for deposit checks; address lookups need Alchemy URLs:
#   https://gnosis-mainnet.g.alchemy.com/v2/<key>   https://ronin-mainnet.g.alchemy.com/v2/<key>
#   https://rootstock-mainnet.g.alchemy.com/v2/<key>
# (the same one Alchemy key). Each also accepts *_RPC_URL_FILE. Never commit or log the real values.
# GNOSIS_RPC_URL=https://rpc.gnosischain.com
# RONIN_RPC_URL=https://api.roninchain.com/rpc
# ROOTSTOCK_RPC_URL=https://public-node.rsk.co

# ZetaChain (7000), Mythos (42018) and the HyperEVM (999, Hyperliquid's EVM side): same shape again.
# Each defaults to the keyless public RPC the chain publishes (shown below), enough for deposit checks;
# address lookups need Alchemy URLs (Mythos's default is Alchemy-hosted but serves core eth_* only):
#   https://zetachain-mainnet.g.alchemy.com/v2/<key>   https://mythos-mainnet.g.alchemy.com/v2/<key>
#   https://hyperliquid-mainnet.g.alchemy.com/v2/<key>
# (the same one Alchemy key). Each also accepts *_RPC_URL_FILE. Never commit or log the real values.
# ZETACHAIN_RPC_URL=https://zetachain-evm.blockpi.network/v1/rpc/public
# MYTHOS_RPC_URL=https://mythos-mainnet.g.alchemy.com/public
# HYPERLIQUID_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Port and bind host for the unified server (packages/server).
PORT=5320
HOST=127.0.0.1

# Exact browser origins allowed to call the server (comma-separated). Never "*". Defaults to
# http://127.0.0.1:5301,http://localhost:5301 if unset -- add your own dev frontend's origin here
# if it's different (e.g. a tailscale/LAN address).
ALLOWED_ORIGINS=http://127.0.0.1:5301,http://localhost:5301

# Local dev only: treats every request as signed in as a fixed fake user, so every feature can be
# driven without going through the real Phantom/MetaMask wallet-connect flow. Refused outright
# when NODE_ENV=production, so it can never activate on a deployed instance. Set to 0 (or unset)
# to test the real wallet-connect flow instead.
DEV_SKIP_AUTH=1

# Public receiving-wallet addresses only (ADR 0020) -- never a private key. A chain left blank
# just can't take bounty deposits yet; this project never generates or holds the key behind
# any of these addresses. Bitcoin is deposit-only (paste a txid; no wallet-connect, no sender check).
# BNB is checked over BNB_RPC_URL; its sender must be the depositor's Ethereum sign-in (same 0x
# address), and it can be the very same address as DEPOSIT_WALLET_ETHEREUM if that key is yours.
# Robinhood Chain works the same way over ROBINHOOD_RPC_URL; it has no USDC/USDT, so beyond native
# ETH its default token is USDG (extend with DEPOSIT_ALLOWED_TOKENS_ROBINHOOD). Base works the same
# way over BASE_RPC_URL: native ETH or Circle's native Base USDC by default (DEPOSIT_ALLOWED_TOKENS_BASE).
# Arbitrum One and OP Mainnet: native ETH or Circle's native USDC on each by default. Zora, Lens Chain
# and the Data Network: native only by default (ETH, GHO, DATA) -- Circle issues no USDC there; add a
# token deliberately with DEPOSIT_ALLOWED_TOKENS_ZORA / _LENS / _STORY. Gnosis Chain, Ronin and
# Rootstock: native only by default too (xDAI, RON, RBTC) -- none has Circle-issued USDC; extend with
# DEPOSIT_ALLOWED_TOKENS_GNOSIS / _RONIN / _ROOTSTOCK. ZetaChain and Mythos: native only by default
# (ZETA; ETH on Mythos, not MYTH) -- their dollar tokens are bridge wrappers; extend with
# DEPOSIT_ALLOWED_TOKENS_ZETACHAIN / _MYTHOS. HyperEVM: native HYPE or Circle's native USDC by default
# (DEPOSIT_ALLOWED_TOKENS_HYPERLIQUID); a deposit must be an ordinary HyperEVM transaction from the
# depositor's own wallet, not a HyperCore-to-HyperEVM transfer.
DEPOSIT_WALLET_ETHEREUM=
DEPOSIT_WALLET_SOLANA=
DEPOSIT_WALLET_BNB=
DEPOSIT_WALLET_ROBINHOOD=
DEPOSIT_WALLET_BASE=
DEPOSIT_WALLET_ARBITRUM=
DEPOSIT_WALLET_OPTIMISM=
DEPOSIT_WALLET_ZORA=
DEPOSIT_WALLET_LENS=
DEPOSIT_WALLET_STORY=
DEPOSIT_WALLET_GNOSIS=
DEPOSIT_WALLET_RONIN=
DEPOSIT_WALLET_ROOTSTOCK=
DEPOSIT_WALLET_ZETACHAIN=
DEPOSIT_WALLET_MYTHOS=
DEPOSIT_WALLET_HYPERLIQUID=
DEPOSIT_WALLET_BITCOIN=

# --- Rarely need to change these ---

# Where the server's SQLite database lives. Relative paths resolve from packages/server/'s cwd.
SERVER_DB=./data/server.db
# Disables new wallet sign-ups (existing sessions keep working) -- e.g. for a frozen demo instance.
ALLOW_SIGNUP=true
# How often the alerts background worker polls watched addresses, in seconds (minimum 5).
ALERT_POLL_SEC=60
# Ethereum balance/transaction data source (no API key needed).
ETH_BLOCKSCOUT_URL=https://eth.blockscout.com
# Bitcoin bounty-deposit verification source, any Esplora-API explorer (no API key needed);
# https://mempool.space works too.
ESPLORA_URL=https://blockstream.info
# Token price data source.
DEFILLAMA_URL=https://coins.llama.fi
# Solana token logos for the portfolio (no API key needed).
JUPITER_TOKENS_URL=https://lite-api.jup.ag/tokens/v2
# Enables POST /api/_test/alerts/tick, used by the test suite -- leave off otherwise.
SERVER_TEST_HOOKS=

# --- Frontend (packages/web), set via the shell or a packages/web/.env.local, not this file ---
# VITE_SERVER_URL=http://localhost:5320
