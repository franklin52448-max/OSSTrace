# Copy to .env and fill in. All of this is optional — the tool works without it, with reduced
# Ethereum transaction-history coverage.

# A standard Ethereum JSON-RPC endpoint. Public default works for light use; a private endpoint
# (Alchemy/Infura/etc free tier) is more reliable for anything beyond quick lookups.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Free key from https://etherscan.io/apis — required for Ethereum transaction history
# (raw JSON-RPC has no "list transactions for an address" call). Balance lookups work without it.
ETHERSCAN_API_KEY=

# A standard Solana RPC endpoint. No key needed at all for Solana — public default works, though
# a private endpoint (Helius/Triton/QuickNode) is more reliable under load.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Port for the Explorer API (packages/features/explorer). Matches this project's assigned port
# block (5300s); change only if you know you need to.
PORT=5300
