# Copy to .env and fill in. All of this is optional — the tool works without it, with reduced
# Ethereum transaction-history coverage.

# A standard Ethereum JSON-RPC endpoint. Public default works for light use; a private endpoint
# (Alchemy/Infura/etc free tier) is more reliable for anything beyond quick lookups.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Free key from https://etherscan.io/apis — required for Ethereum transaction history
# (raw JSON-RPC has no "list transactions for an address" call). Balance lookups work without it.
ETHERSCAN_API_KEY=

# A standard Solana RPC endpoint. No key needed at all for Solana — public default works, though
# a private endpoint (Helius/Triton/QuickNode) is more reliable under load.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Port for the Explorer API (packages/features/explorer). Matches this project's assigned port
# block (5300s); change only if you know you need to.
PORT=5300

# Optional. Without this, the Explorer uses an in-memory cache (works fine for one process, but
# isn't shared with the background indexer or a second server instance). Set this to a real Redis
# URL to share the cache + popularity ranking across processes -- required for the indexer
# (npm run --workspace packages/features/explorer indexer) to actually do anything useful.
# Local: `brew install redis && redis-server` -> redis://127.0.0.1:6379
# Hosted free tier: Upstash (https://upstash.com) -- see SCALING-AND-COSTS.md (local only).
REDIS_URL=

# How often the background indexer refreshes the most-looked-up addresses, in milliseconds.
INDEXER_INTERVAL_MS=30000
# How many of the most-looked-up addresses the indexer keeps warm each cycle.
INDEXER_TOP_N=20

# Accounts API (packages/features/accounts) -- see docs/adr/0006-accounts-and-auth.md.
ACCOUNTS_PORT=5310
# Where accounts (password hashes + emails) are stored. Default data/private/accounts.json is
# git-ignored. Relative paths resolve from the repo root.
ACCOUNTS_STORE_PATH=
# Exact browser origins allowed to call the accounts API (comma-separated). Never use "*".
ACCOUNTS_ALLOWED_ORIGINS=http://localhost:5301

# Private labels API (packages/features/private-labels) -- per-user labels only their owner sees.
# Reads sessions from ACCOUNTS_STORE_PATH above, so run it alongside the accounts API.
PRIVATE_LABELS_PORT=5312
# Where private labels are stored. Default data/private/private-labels.json is git-ignored.
PRIVATE_LABELS_STORE_PATH=
# Exact browser origins allowed (comma-separated). Falls back to ACCOUNTS_ALLOWED_ORIGINS. Never "*".
PRIVATE_LABELS_ALLOWED_ORIGINS=

# Community label submissions + moderation API (packages/features/community-labels) -- see
# docs/adr/0007-community-label-submissions-and-review.md. Uses the same accounts file as above.
COMMUNITY_LABELS_PORT=5311
# Where submissions are stored. Default data/community/submissions.json is git-ignored. Relative
# paths resolve from the repo root. The Explorer and Visualizer read the same file.
COMMUNITY_LABELS_PATH=
# Exact browser origins allowed to call the community labels API (comma-separated). Never "*".
COMMUNITY_LABELS_ALLOWED_ORIGINS=http://localhost:5301

# Tracer API (packages/features/tracer) -- multi-hop fund tracing, see
# docs/adr/0008-tracer-multi-hop-search-design.md. No new config: reuses ETH_RPC_URL/
# ETHERSCAN_API_KEY/SOLANA_RPC_URL above.
TRACER_PORT=5303
# Optional. Cross-chain bridge hops (?bridges=wormhole, see
# docs/adr/0012-tracer-cross-chain-bridge-hops-via-wormhole.md) use Wormhole's public Wormholescan
# API, which needs no key. Leave blank for the public default (https://api.wormholescan.io).
WORMHOLESCAN_API_URL=

# Risk scoring API (packages/features/risk-scoring) -- see docs/adr/0010-risk-scoring-model.md.
# No new config: reuses the RPC settings above and runs Tracer's traceGraph in-process.
RISK_SCORING_PORT=5305

# Bounty board API (packages/features/bounties) -- see
# docs/adr/0009-bounty-program-v1-is-tracking-only.md. Uses the same accounts file as above.
BOUNTIES_PORT=5313
# Where bounties + submissions are stored. Default data/bounties/bounties.json is git-ignored.
BOUNTIES_PATH=
# Exact browser origins allowed (comma-separated). Falls back to ACCOUNTS_ALLOWED_ORIGINS. Never "*".
BOUNTIES_ALLOWED_ORIGINS=http://localhost:5301

# Case management API (packages/features/case-management) -- per-user private cases, see
# docs/adr/0011-case-management-private-owner-only-cases.md. Uses the same accounts file as above.
CASES_PORT=5314
# Where cases + their items are stored. Default data/private/cases.json is git-ignored.
CASES_PATH=
# Exact browser origins allowed (comma-separated). Falls back to ACCOUNTS_ALLOWED_ORIGINS. Never "*".
CASES_ALLOWED_ORIGINS=
